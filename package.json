{
  "name": "@gunkin/uiify",
  "version": "0.0.31-alpha",
  "description": "Native-first, accessible React 19 components that work before hydration.",
  "keywords": [
    "accessibility",
    "components",
    "headless-ui",
    "native-html",
    "react",
    "server-components",
    "tanstack-intent"
  ],
  "homepage": "https://uiify.gunkin.dev/",
  "bugs": {
    "url": "https://github.com/antongunkin/uiify/issues"
  },
  "license": "MIT",
  "author": "Anton Gunkin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antongunkin/uiify.git"
  },
  "files": [
    "dist",
    "agents",
    "skills"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "core/*": [
        "dist/core/*"
      ],
      "hooks": [
        "dist/hooks/index.d.ts"
      ],
      "hooks/*": [
        "dist/hooks/*"
      ],
      "elements": [
        "dist/elements/index.d.ts"
      ],
      "elements/*": [
        "dist/elements/*"
      ],
      "ai": [
        "dist/ai/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./core/*": {
      "types": "./dist/core/*.d.ts",
      "import": "./dist/core/*.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./components/behavior.css": "./dist/components/behavior.css",
    "./elements": {
      "types": "./dist/elements/index.d.ts",
      "import": "./dist/elements/index.js"
    },
    "./elements/*": {
      "types": "./dist/elements/*.d.ts",
      "import": "./dist/elements/*.js"
    },
    "./elements/behavior.css": "./dist/components/behavior.css",
    "./behavior.css": "./dist/components/behavior.css",
    "./tailwind.css": "./dist/styles/tailwind.css",
    "./themes/*.css": "./dist/styles/themes/*.css",
    "./styles/define": {
      "types": "./dist/styles/define.d.ts",
      "import": "./dist/styles/define.js"
    },
    "./internal/styles/build/snippet": {
      "types": "./dist/styles/build/snippet.d.ts",
      "import": "./dist/styles/build/snippet.js"
    },
    "./internal/styles/uiify": {
      "types": "./dist/styles/uiify/index.d.ts",
      "import": "./dist/styles/uiify/index.js"
    },
    "./styles/uiify.css": "./dist/styles/uiify.css",
    "./styles/uiify.scoped.css": "./dist/styles/uiify.scoped.css",
    "./styles/uiify/*.css": "./dist/styles/uiify/*.css",
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "import": "./dist/ai/index.js"
    },
    "./styles": "./dist/styles/index.css",
    "./styles/index.css": "./dist/styles/index.css",
    "./styles.css": "./dist/styles/index.css",
    "./styles/tokens": "./dist/styles/tokens.css",
    "./styles/tokens.css": "./dist/styles/tokens.css",
    "./styles/tailwind": "./dist/styles/tailwind-legacy.css",
    "./styles/tailwind.css": "./dist/styles/tailwind-legacy.css",
    "./styles/layout": "./dist/styles/layout.css",
    "./styles/layout.css": "./dist/styles/layout.css",
    "./styles/controls": "./dist/styles/controls.css",
    "./styles/controls.css": "./dist/styles/controls.css",
    "./styles/layout/tailwind": {
      "types": "./dist/styles/layout/tailwind.d.ts",
      "import": "./dist/styles/layout/tailwind.js"
    },
    "./styles/layout/tailwind-manifest": {
      "types": "./dist/styles/layout/tailwind-manifest.generated.d.ts",
      "import": "./dist/styles/layout/tailwind-manifest.generated.js"
    },
    "./styles/reset": "./dist/styles/reset.css",
    "./styles/reset.css": "./dist/styles/reset.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "dev": "tsup --watch",
    "size": "size-limit",
    "size:update": "node scripts/update-size-limits.mjs",
    "format": "oxfmt src scripts tsup.config.ts vitest.config.ts vitest.setup.ts package.json tsconfig.json tsconfig.build.json .size-limit.json README.md .github",
    "format:check": "npm run format -- --check",
    "lint": "oxlint --config .oxlintrc.json src scripts",
    "stylelint": "stylelint \"src/**/*.css\"",
    "check:layout-reads": "node scripts/check-banned-layout-reads.mjs",
    "check:package": "publint . && attw --pack . --profile esm-only --exclude-entrypoints ./components/behavior.css ./behavior.css ./tailwind.css ./themes/*.css ./styles/uiify.css ./styles/uiify.scoped.css ./styles/uiify/*.css ./elements/behavior.css ./styles ./styles/index.css ./styles.css ./styles/tokens ./styles/tokens.css ./styles/tailwind ./styles/tailwind.css ./styles/layout ./styles/layout.css ./styles/controls ./styles/controls.css ./styles/reset ./styles/reset.css",
    "verify:tarball": "node scripts/verify-tarball.mjs",
    "check": "npm run format:check && npm run lint && npm run stylelint && npm run typecheck && npm run build && npm test && npm run check:layout-reads && npm run check:package && npm run size",
    "release:check": "npm run check && npm run verify:tarball",
    "prepack": "npm run build",
    "prepublishOnly": "npm run release:check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@ladle/react": "^5.1.1",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@tailwindcss/node": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "browserslist": "^4.29.5",
    "html-validate": "^11.19.0",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.33.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "postcss": "^8.5.32",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^12.1.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-plugin-logical-css": "^2.1.0",
    "tailwindcss": "^4.3.5",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "react": ">=19.3.0",
    "react-dom": ">=19.3.0",
    "tailwindcss": "^4.1.0"
  },
  "packageManager": "npm@11.7.0"
}
